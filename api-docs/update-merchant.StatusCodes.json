{"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"type":"object","description":"A merchant (store) registered in CorePOS.","properties":{"id":{"type":"string","format":"uuid","description":"Unique UUID identifier of the merchant.","example":"6aa9a46e-9fea-454f-b52f-05877a569275"},"name":{"type":"string","description":"Business name of the merchant.","example":"Corner Store"},"address1":{"type":"string","description":"First street address line.","example":1450},"address2":{"type":"string","description":"Second street address line.","example":"Suite 2"},"address3":{"type":"string","description":"Third street address line.","example":"Building B"},"city":{"type":"string","description":"City of the merchant's address.","example":"San Francisco"},"country":{"type":"string","description":"Country of the merchant's address.","example":"US"},"state":{"type":"string","description":"State or province of the merchant's address.","example":"CA"},"zip":{"type":"string","description":"Postal (ZIP) code of the merchant's address.","example":94103},"phoneNumber":{"type":"string","description":"Contact phone number of the merchant.","example":"+14155550142"},"isDemo":{"type":"boolean","description":"Whether this is a demo merchant with sample data.","example":false}},"required":["id","isDemo","name"],"title":"MerchantDto"}}}}}}